{
  "name": "vwo-login-automation",
  "version": "1.0.0",
  "description": "Playwright automation framework for VWO Login Dashboard",
  "author": "Senior QA Engineer",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:chrome": "playwright test --project=chrome",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:positive": "playwright test tests/positive/",
    "test:negative": "playwright test tests/negative/",
    "test:security": "playwright test tests/security/",
    "test:accessibility": "playwright test tests/accessibility/",
    "test:performance": "playwright test tests/performance/",
    "report": "playwright show-report",
    "codegen": "playwright codegen https://app.vwo.com/#/login",
    "trace": "playwright show-trace"
  },
  "keywords": [
    "playwright",
    "testing",
    "vwo",
    "automation",
    "e2e"
  ],
  "devDependencies": {
    "@axe-core/playwright": "^4.8.0",
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.10.0",
    "dotenv": "^16.3.1",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "chalk": "^4.1.2"
  }
}
