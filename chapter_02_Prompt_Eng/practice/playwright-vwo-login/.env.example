# VWO Login Automation - Environment Configuration
# Copy this file to .env and update with actual values

# Application Configuration
BASE_URL=https://app-staging.vwo.com
LOGIN_URL=https://app-staging.vwo.com/#/login
FORGOT_PASSWORD_URL=https://app-staging.vwo.com/#/forgot-password
SIGNUP_URL=https://app-staging.vwo.com/#/sign-up

# Test Credentials
VALID_EMAIL=test.user@vwo.com
VALID_PASSWORD=SecurePass123!@#
VALID_EMAIL_2=qa.engineer@example.com
VALID_PASSWORD_2=TestPass456!@#

# Invalid/Edge Case Test Data
INVALID_EMAIL=nonexistent@example.com
INVALID_EMAIL_FORMAT=invalidformat
LOCKED_EMAIL=locked.user@vwo.com
MFA_EMAIL=mfa.user@vwo.com

# Test Configuration
WAIT_TIMEOUT=10000
ACTION_TIMEOUT=5000
NAVIGATION_TIMEOUT=30000
INACTIVITY_TIMEOUT=1800000

# Browser Configuration
HEADLESS=true
SLOW_MO=0
DEVICE=Desktop Chrome

# Accessibility
ACCESSIBILITY_ENABLED=true
SCREEN_READER_TEST=true

# Performance
PERFORMANCE_TEST=true
PAGE_LOAD_TIMEOUT=2000

# Security
HTTPS_VERIFICATION=true
RATE_LIMIT_THRESHOLD=5
RATE_LIMIT_WAIT_TIME=900000

# Logging
LOG_LEVEL=info
DEBUG=false

# CI/CD
CI=false
PARALLEL_WORKERS=4
RETRY_COUNT=1

# Reporting
REPORT_FORMAT=html,json,junit
REPORT_DIR=test-results
